<Project Sdk="Microsoft.NET.Sdk">

  <!-- Проверка разбора smartrelay.json без розетки и без окна.
       Запуск: dotnet run project tests/ConfigTests (из корня репозитория) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ConfigTests</AssemblyName>
    <RootNamespace>ConfigTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../AppConfig.cs" Link="AppConfig.cs" />
  </ItemGroup>

</Project>
