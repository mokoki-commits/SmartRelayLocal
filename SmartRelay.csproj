<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Версия и сведения о программе: попадают в окно «О программе» и в свойства exe -->
    <Version>6.0.3</Version>
    <AssemblyVersion>6.0.3</AssemblyVersion>
    <FileVersion>6.0.3</FileVersion>
    <Product>SmartRelay</Product>
    <Company>avk013</Company>
    <Copyright>© 2026 avk013 · лицензия MIT</Copyright>
    <Description>Локальное управление розеткой SmartLife / Tuya по LAN (протокол 3.4 / 3.1)</Description>
    <!-- значок файла SmartRelay.exe для Проводника и панели задач (кадры 16–256 в одном .ico) -->
    <ApplicationIcon>smartrelay.ico</ApplicationIcon>
    <!--
      SDK встраивает значок в apphost только сборкой на Windows и на Linux выдаёт NETSDK1074.
      Предупреждение гасим, а ресурсы (значок, версия, манифест) переносим в exe сами — задача
      PatchAppHostResources ниже, см. build/PatchAppHostResources.cs.
    -->
    <MSBuildWarningsAsMessages Condition="'$(OS)' != 'Windows_NT'">$(MSBuildWarningsAsMessages);NETSDK1074</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <!-- tests/ — отдельный проект проверки конфига, в сборку приложения не входит -->
    <Compile Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
    <None Remove="tests/**" />
    <!-- build/ — код MSBuild-задач, компилируется самим MSBuild, в сборку приложения не входит -->
    <Compile Remove="build/**" />
    <EmbeddedResource Remove="build/**" />
    <None Remove="build/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- шаблон конфига кладём рядом с exe, чтобы его было легко скопировать в smartrelay.json -->
    <None Update="smartrelay.json.example">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <!-- значок программы: готовый .ico (окно, трей, exe) либо картинка .png/.bmp рядом с exe (AppIcon.cs) -->
    <None Update="smartrelay.ico;smartrelay.png;smartrelay.bmp;smartrealy.bmp;smartleray.bmp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <!-- текст лицензии также кладём рядом с exe (кнопка «Открыть лицензию» в окне «О программе») -->
    <None Update="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!--
    Кросс-сборка на Linux собирает apphost с консольной подсистемой (PE subsystem = 3),
    из-за чего перед окном формы на Windows мелькает консоль.
    Правим 2 байта в заголовке PE (как это делает editbin /SUBSYSTEM:WINDOWS) — уже после сборки.
  -->
  <UsingTask TaskName="SetGuiSubsystem"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <TargetFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (System.IO.File.Exists(TargetFile))
        {
            byte[] bytes = System.IO.File.ReadAllBytes(TargetFile);
            int peOffset = System.BitConverter.ToInt32(bytes, 0x3C);
            if (peOffset > 0 && peOffset + 0x5C < bytes.Length)
            {
                int subsystemField = peOffset + 24 + 68;
                ushort subsystem = System.BitConverter.ToUInt16(bytes, subsystemField);
                if (subsystem == 3) // IMAGE_SUBSYSTEM_WINDOWS_CUI
                {
                    bytes[subsystemField] = 2;      // IMAGE_SUBSYSTEM_WINDOWS_GUI
                    bytes[subsystemField + 1] = 0;
                    System.IO.File.WriteAllBytes(TargetFile, bytes);
                    Log.LogMessage(MessageImportance.High, "SmartRelay: подсистема exe исправлена на GUI (без консольного окна)");
                }
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="FixGuiSubsystemBuild" AfterTargets="Build"
          Condition="Exists('$(TargetDir)$(AssemblyName).exe')">
    <SetGuiSubsystem TargetFile="$(TargetDir)$(AssemblyName).exe" />
  </Target>

  <Target Name="FixGuiSubsystemPublish" AfterTargets="Publish"
          Condition="'$(PublishDir)' != '' And Exists('$(PublishDir)$(AssemblyName).exe')">
    <SetGuiSubsystem TargetFile="$(PublishDir)$(AssemblyName).exe" />
  </Target>

  <!--
    Кросс-сборка на Linux/macOS: значок, версия и манифест попадают только в SmartRelay.dll,
    а apphost exe остаётся без ресурсов (SDK умеет встраивать их лишь на Windows, NETSDK1074) —
    в Проводнике такой exe выглядит «безликим». Задача ниже дописывает в exe секцию .rsrc из dll.
    На Windows она ничего не делает: там ресурсы уже встроены самим SDK.
  -->
  <UsingTask TaskName="PatchAppHostResources"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <AppHostPath ParameterType="System.String" Required="true" />
      <ManagedAssemblyPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs" Source="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'build', 'PatchAppHostResources.cs'))" />
    </Task>
  </UsingTask>

  <Target Name="PatchAppHostResourcesBuild" AfterTargets="Build"
          Condition="'$(OS)' != 'Windows_NT' And Exists('$(TargetDir)$(AssemblyName).exe')">
    <PatchAppHostResources AppHostPath="$(TargetDir)$(AssemblyName).exe"
                           ManagedAssemblyPath="$(TargetDir)$(AssemblyName).dll" />
  </Target>

  <Target Name="PatchAppHostResourcesPublish" AfterTargets="Publish"
          Condition="'$(OS)' != 'Windows_NT' And '$(PublishDir)' != '' And Exists('$(PublishDir)$(AssemblyName).exe')">
    <PatchAppHostResources AppHostPath="$(PublishDir)$(AssemblyName).exe"
                           ManagedAssemblyPath="$(PublishDir)$(AssemblyName).dll" />
  </Target>

</Project>

